# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/playwright/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user-uploaded files (local storage backend)
/public/uploads/*
!/public/uploads/.gitkeep

# private (non-public) uploads - delivery-report photos, served only via an authenticated route
/uploads-private/*
!/uploads-private/.gitkeep

# local Postgres data directory (scripts/db-start.mjs)
/.pgdata
