# Local Postgres (a real, project-local Postgres binary, no Docker/admin rights needed).
# The port/db name below match what `npm run db:start` provisions - only change if you edit that script too.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/betolla?sslmode=disable"

# Signs session JWTs. Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="replace-with-a-random-secret"

# The single seeded Admin account. Read only by prisma/seed.ts - never exposed via any UI.
ADMIN_EMAIL="admin@betolla.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Base URL used for building absolute links (e.g. in simulated notifications) and as the Google
# OAuth redirect base (see GOOGLE_CLIENT_ID below).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# "Continue with Google" on /login and /register. Create an OAuth 2.0 Client ID (type: Web
# application) at https://console.cloud.google.com/apis/credentials, and add this exact Authorized
# redirect URI there: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Real transactional email (order updates, abandoned-cart reminders, etc.) via Resend
# (https://resend.com/api-keys). Left unset, notify() falls back to its previous behavior -
# still writes the in-app Notification row, just skips the real send instead of erroring.
RESEND_API_KEY="re_your_api_key"
# Must be either Resend's shared sandbox address (works immediately, no setup, but only
# deliverable to the account's own verified test addresses) or an address on a domain you've
# verified in Resend (Domains tab) - swap this once betolla.com (or similar) is verified there.
EMAIL_FROM="Betolla Cosmetics <onboarding@resend.dev>"

# Only enable when the app is behind a reverse proxy you control which overwrites
# X-Forwarded-For/X-Real-IP. Leave false for direct/local traffic.
TRUST_PROXY="false"
