# Local Postgres (a real, project-local Postgres binary, no Docker/admin rights needed).
# The port/db name below match what `npm run db:start` provisions - only change if you edit that script too.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/betolla?sslmode=disable"

# Signs session JWTs. Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="replace-with-a-random-secret"

# The single seeded Admin account. Read only by prisma/seed.ts - never exposed via any UI.
ADMIN_EMAIL="admin@betolla.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Base URL used for building absolute links (e.g. in simulated notifications).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
